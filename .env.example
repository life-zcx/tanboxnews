# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (e.g. gemini-2.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Autonomous monitoring interval in minutes
CHECK_INTERVAL_MINUTES=60

# Channel username or ID for 1-click publishing
AUTO_POST_CHANNEL_ID=@tanboxkz

# Comma-separated list of allowed admin Telegram user IDs (e.g. 12345678,87654321)
ADMIN_IDS=8563274673

# Optional: Google Sheets Webhook URL for auto-syncing content plan
GOOGLE_SHEET_WEBHOOK_URL=

# Meta Threads API Configuration
THREADS_ACCESS_TOKEN=your_threads_long_lived_token_here
THREADS_USER_ID=your_threads_user_id_here
THREADS_USERNAME=tanbox.kz

